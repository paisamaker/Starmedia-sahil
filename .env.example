# EmailJS public configuration. Set the template's To Email to the STAR MEDIA inbox.
# Never commit a filled .env file.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public site origin, no trailing slash. Used for canonical URLs, Open Graph, sitemap, and robots.txt.
VITE_SITE_URL=https://starmediainfluencer.com

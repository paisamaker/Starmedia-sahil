# EmailJS public configuration.
# In the EmailJS template, set To Email to contact@starmediainfluencer.com
# (or {{to_email}} — the app sends to_email as that address).
# Never commit a filled .env file.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public site origin, no trailing slash. Used for canonical URLs, Open Graph, sitemap, and robots.txt.
VITE_SITE_URL=https://starmediainfluencer.com
